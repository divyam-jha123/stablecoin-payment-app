{
  "name": "@traveller/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm run build",
    "dev": "node --watch --env-file-if-exists=../../.env dist/server.js",
    "prebuild": "pnpm --filter @traveller/shared build",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@traveller/shared": "workspace:*",
    "viem": "^2.56.5",
    "zod": "^4.1.0"
  }
}
