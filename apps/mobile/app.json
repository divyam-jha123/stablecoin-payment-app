{
  "expo": {
    "name": "Traveller Pay",
    "slug": "tempo-traveller-payments",
    "scheme": "travellerpay",
    "version": "0.0.1",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TravelPe to scan payment QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow TravelPe to save your payment QR image.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "android": {
      "package": "com.travellerpay.hackathon"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
