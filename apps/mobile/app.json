{
  "expo": {
    "name": "Traveller Pay",
    "slug": "tempo-traveller-payments",
    "scheme": "travellerpay",
    "version": "0.0.1",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Traveller Pay to scan merchant UPI QR codes."
        }
      ]
    ],
    "android": {
      "package": "com.travellerpay.hackathon"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
