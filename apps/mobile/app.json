{
  "expo": {
    "name": "TravelPay",
    "slug": "tempo-traveller-payments",
    "scheme": [
      "travellerpay",
      "com.travellerpay.hackathon"
    ],
    "version": "0.0.1",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/native-splash.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TravelPe to scan payment QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow TravelPe to save your payment QR image.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow TravelPe to sign in securely with Face ID."
        }
      ],
      "expo-web-browser",
      "./plugins/with-crop-done-label"
    ],
    "android": {
      "package": "com.travellerpay.hackathon"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fe45311-1e43-46e6-b53b-be2b648f3858"
      }
    }
  }
}
