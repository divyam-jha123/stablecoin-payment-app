{
  "name": "tempo-traveller-payments",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "dev:mobile": "pnpm --filter @traveller/mobile dev",
    "dev:api": "pnpm --filter @traveller/api dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @traveller/shared build && pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
