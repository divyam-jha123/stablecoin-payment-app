# Used by the health-only API bootstrap. Real payment routes are not enabled.
PORT=3000
# Only development, test and hackathon-demo are accepted.
APP_ENV=development
# Mobile API origin. For a physical device, use the development machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Wallet, Tempo RPC/token selection, database, pricing and provider credentials
# are intentionally absent until those integrations are selected and implemented.
# Never put private keys, recovery phrases or real credentials here.

# "Sign up with Google": OAuth client IDs from Google Cloud Console, one per
# platform you build for (application type Android: package
# com.travellerpay.hackathon + signing SHA-1; application type iOS: bundle ID).
# Client IDs are not secrets. Needs a development or release build, not Expo Go.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
